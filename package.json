{
  "name": "@bloomler/headlessui-solid",
  "version": "0.1.0-beta.3",
  "description": "Unofficial, community-maintained Headless UI port for SolidJS 2.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bloomler/headlessui-solid.git"
  },
  "homepage": "https://github.com/bloomler/headlessui-solid#readme",
  "bugs": {
    "url": "https://github.com/bloomler/headlessui-solid/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.browser.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.mjs",
      "deno": "./dist/index.mjs",
      "worker": "./dist/index.mjs",
      "node": "./dist/index.mjs",
      "import": "./dist/index.browser.mjs",
      "default": "./dist/index.browser.mjs"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "deno task build",
    "audit": "deno task audit",
    "check": "deno task check",
    "fmt": "deno task fmt",
    "lint": "deno task lint",
    "test": "deno task test",
    "test:dom": "deno task test:dom",
    "verify": "deno task verify",
    "verify:all": "deno task verify:all",
    "prepack": "deno task build"
  },
  "keywords": [
    "accessible",
    "components",
    "headless",
    "solid",
    "solidjs",
    "ui"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0"
  },
  "peerDependencies": {
    "@solidjs/web": ">=2.0.0-beta.25 <3.0.0",
    "solid-js": ">=2.0.0-beta.25 <3.0.0"
  }
}
